{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name",
    "object",
    "riskLevel",
    "target",
    "approval",
    "intent",
    "params"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "object": {
      "type": "string",
      "minLength": 1
    },
    "riskLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "intent": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "required": [
        "serviceRef",
        "draft",
        "commit"
      ],
      "properties": {
        "serviceRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "draft": {
          "type": "object",
          "required": [
            "method",
            "path"
          ],
          "properties": {
            "method": {
              "const": "POST"
            },
            "path": {
              "type": "string",
              "pattern": "^/(?!/)(?!.*\\.\\.)[^%?#\\\\]*$",
              "maxLength": 512
            }
          },
          "additionalProperties": false
        },
        "commit": {
          "type": "object",
          "required": [
            "method",
            "path"
          ],
          "properties": {
            "method": {
              "enum": [
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^/(?!/)(?!.*\\.\\.)[^%?#\\\\]*$",
              "maxLength": 512
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "HITL",
            "AUTO"
          ]
        },
        "requiredRole": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "domain": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "riskLevel": {
            "const": "high"
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "required": [
              "requiredRole"
            ],
            "properties": {
              "mode": {
                "const": "HITL"
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}

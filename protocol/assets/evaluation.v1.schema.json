{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "cases"
      ]
    },
    {
      "required": [
        "domains"
      ]
    },
    {
      "required": [
        "samples"
      ]
    }
  ]
}

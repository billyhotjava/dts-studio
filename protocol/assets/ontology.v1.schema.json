{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "domain",
    "objects"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "view"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "view": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "links": {
      "type": "array"
    },
    "metrics": {
      "type": "array"
    },
    "actions": {
      "type": "array"
    },
    "synonyms": {
      "type": [
        "array",
        "object"
      ]
    }
  }
}

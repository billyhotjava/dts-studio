#!/usr/bin/env bash
set -euo pipefail
engine_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
pack_jar="$engine_dir/engine-ai/target/dts-copilot-ai-1.0.0-SNAPSHOT.jar"
if [[ ! -f "$pack_jar" ]]; then
  echo 'Build the Studio backend first with ./build.sh package in the build checkout.' >&2
  exit 1
fi
exec java -Dloader.main=com.yuzhi.dts.copilot.ai.service.pack.PackCli -cp "$pack_jar" \
  org.springframework.boot.loader.launch.PropertiesLauncher "$@"

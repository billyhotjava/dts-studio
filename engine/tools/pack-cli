#!/usr/bin/env bash
# Compatibility launcher; consumes the installed Common CLI artifact, not a Studio service jar.
set -euo pipefail
jar="${DTS_PACK_CLI_JAR:-${DTS_MAVEN_REPOSITORY:-$HOME/.m2/repository}/com/yuzhi/dts/dts-common-pack/1.0.0/dts-common-pack-1.0.0-cli.jar}"
if [[ ! -f "$jar" ]]; then echo 'Install dts-common 1.0.0, or set DTS_PACK_CLI_JAR.' >&2; exit 1; fi
exec "${JAVA:-java}" -jar "$jar" "$@"

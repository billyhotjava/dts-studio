<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="v1_0_0_029_finance_reconciliation_scorecard_snapshot" author="codex">
        <createTable tableName="finance_reconciliation_scorecard_snapshot">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_finance_reconciliation_scorecard_snapshot"/>
            </column>
            <column name="oracle_binding_id" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="scorecard_id" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="health_status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="passed" type="BOOLEAN"/>
            <column name="drifted" type="BOOLEAN"/>
            <column name="total_checks" type="INT"/>
            <column name="passed_checks" type="INT"/>
            <column name="pass_rate" type="DECIMAL(8,2)"/>
            <column name="max_difference" type="DECIMAL(18,2)"/>
            <column name="failure_message" type="TEXT"/>
            <column name="report_json" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex
            indexName="idx_finance_scorecard_snapshot_binding_created"
            tableName="finance_reconciliation_scorecard_snapshot">
            <column name="oracle_binding_id"/>
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

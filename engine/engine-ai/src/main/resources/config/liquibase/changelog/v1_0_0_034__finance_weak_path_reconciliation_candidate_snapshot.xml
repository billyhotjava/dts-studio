<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="v1_0_0_034_finance_weak_path_reconciliation_candidate_snapshot" author="codex">
        <createTable tableName="finance_weak_path_reconciliation_candidate_snapshot">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_finance_weak_path_reconciliation_candidate_snapshot"/>
            </column>
            <column name="run_id" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="policy_id" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="candidate_key" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="final_tier" type="VARCHAR(64)"/>
            <column name="domain" type="VARCHAR(64)"/>
            <column name="response_kind" type="VARCHAR(64)"/>
            <column name="target" type="VARCHAR(512)"/>
            <column name="data_surface" type="VARCHAR(256)"/>
            <column name="source_count" type="BIGINT"/>
            <column name="priority_score" type="INT"/>
            <column name="semantic_draft_action" type="VARCHAR(64)"/>
            <column name="semantic_draft_id" type="VARCHAR(128)"/>
            <column name="semantic_draft_status" type="VARCHAR(64)"/>
            <column name="reason" type="VARCHAR(512)"/>
            <column name="question_samples_json" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="reconciliation_sets_json" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex
            indexName="idx_finance_weak_path_candidate_policy_created"
            tableName="finance_weak_path_reconciliation_candidate_snapshot">
            <column name="policy_id"/>
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>

        <createIndex
            indexName="idx_finance_weak_path_candidate_key_created"
            tableName="finance_weak_path_reconciliation_candidate_snapshot">
            <column name="candidate_key"/>
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

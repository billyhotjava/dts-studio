{
  "version": "2026-07-sprint33-finance-oracle-registry-v1",
  "bindings": [
    {
      "id": "month-settlement",
      "reportName": "月对账",
      "oracleLevel": "L2",
      "chain": "rent-settlement",
      "sourceTables": ["a_month_accounting", "a_green_accounting"],
      "amountColumns": [
        "receivable_total_amount",
        "net_receipt_total_amount",
        "folding_after_total_amount",
        "total_amount"
      ],
      "endpoints": [
        {
          "level": "L2",
          "method": "GET",
          "path": "/rs-flowers-base/operate/monthAccount/listMonthAccountingPage",
          "controller": "MonthAccountController",
          "handler": "listMonthAccountingPage",
          "requestParams": ["MonthAccountingQueryBo"]
        },
        {
          "level": "L2",
          "method": "POST",
          "path": "/rs-flowers-base/operate/monthAccount/getMonthSettlementData",
          "controller": "MonthAccountController",
          "handler": "getMonthSettlementData",
          "requestParams": ["MonthAccountingConfigBo"]
        }
      ],
      "ledger": {},
      "adminWebEvidence": [
        "adminweb/src/api/flower/operate/monthAccount.js",
        "adminweb/src/views/flower/operate/bill/list-bill.vue",
        "adminweb/src/views/flower/operate/bill/components/create-month-account-new.vue"
      ],
      "notes": "租摆链 oracle 使用应用系统服务层输出，不能用 a_month_accounting 裸 SUM 替代业务所见。"
    },
    {
      "id": "sale-account",
      "reportName": "售账",
      "oracleLevel": "L2",
      "chain": "sale-gift-bad-debt",
      "sourceTables": ["a_sale_account"],
      "amountColumns": ["receivable", "total_amount", "tax_amount"],
      "endpoints": [
        {
          "level": "L2",
          "method": "GET",
          "path": "/rs-flowers-base/operate/saleAccount/listSaleAccountPage",
          "controller": "SaleAccountController",
          "handler": "listSaleAccountPage",
          "requestParams": ["SaleAccountQueryBo"]
        }
      ],
      "ledger": {},
      "adminWebEvidence": [
        "adminweb/src/api/flower/operate/saleAccount.js",
        "adminweb/src/views/flower/operate/sale/list-sale-account.vue"
      ],
      "notes": "售花/赠送/坏账链含增值税，和月对账租摆链不可直接混合汇总。"
    },
    {
      "id": "voucher-ledger",
      "reportName": "凭证",
      "oracleLevel": "L3",
      "chain": "voucher-ledger",
      "sourceTables": ["f_voucher", "f_voucher_item"],
      "amountColumns": ["debit_amount", "credit_amount"],
      "endpoints": [
        {
          "level": "L3",
          "method": "GET",
          "path": "/rs-flowers-base/finace/voucher/list",
          "controller": "VoucherController",
          "handler": "list",
          "requestParams": ["VoucherQueryBo"]
        },
        {
          "level": "L3",
          "method": "POST",
          "path": "/rs-flowers-base/finace/voucher/listByCodes",
          "controller": "VoucherController",
          "handler": "listByCodes",
          "requestParams": ["List<String> codes"]
        },
        {
          "level": "L3",
          "method": "GET",
          "path": "/rs-flowers-base/finace/voucher/listVoucherItems",
          "controller": "VoucherController",
          "handler": "listVoucherItems",
          "requestParams": ["VoucherItemVo"]
        }
      ],
      "ledger": {
        "voucherTable": "f_voucher",
        "itemTable": "f_voucher_item",
        "debitColumn": "debit_amount",
        "creditColumn": "credit_amount",
        "subjectColumn": "subject_id",
        "voucherCodeColumn": "code"
      },
      "adminWebEvidence": [
        "adminweb/src/api/flower/finance/voucher.js"
      ],
      "notes": "凭证明细以 debit_amount=credit_amount 复式平衡作为 L3 会计级 oracle。"
    }
  ]
}
